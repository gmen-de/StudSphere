# Runtime-generated storage: downloaded Rebrickable CSVs and the import log.
# The directory itself (and its .htaccess) stays tracked; only its contents are ignored.
/storage/rebrickable/*
!/storage/.htaccess

# Downloaded set/minifig/part images (potentially tens of thousands of files).
/public/images/

# Local, environment-specific DB credentials — never shipped in git, so a
# fresh `git pull`/release copy never overwrites the admin's real config.
# src/config.example.php is the tracked template; setup.php generates the
# real file on first run.
/src/config.php
